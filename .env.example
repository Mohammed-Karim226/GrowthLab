# Copy to .env.local (or .env) and fill in. Never commit real values — plan §71.
# Both files are gitignored; only this example is tracked.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Supabase renamed its API keys. Either naming scheme works; use whichever your
# project dashboard shows and set only one of each pair.
#
#   classic                        new
#   anon key                  ->   publishable key  (sb_publishable_...)
#   service_role key          ->   secret key       (sb_secret_...)

# Project URL. Prefix with NEXT_PUBLIC_ only if browser code needs it; the app
# as it stands talks to Supabase exclusively from the server.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key. Safe to expose — RLS still applies to it.
SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service-role key. BYPASSES RLS. Server-only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Credential vault encryption (admin Gmail credentials)
# ---------------------------------------------------------------------------
# Server-only. Without both of these every save in the Gmail credential vault
# fails with 503 `credentialConfig` — nothing else in the app is affected.
#
# CREDENTIAL_ENCRYPTION_KEYS is a JSON object of keyId -> base64 32-byte key.
# Key ids match [A-Za-z0-9_-]{1,32}; values must be exactly 32 bytes, standard
# base64 (44 chars ending in "="). Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Keep every key that has ever been active: ciphertext records the id it was
# written under, so dropping an old key makes those rows undecryptable forever.
# To rotate, add a new id to the map and point CREDENTIAL_ACTIVE_KEY_ID at it;
# old rows keep decrypting under the old key until they are re-saved.
# Use a DIFFERENT key per environment — never share the production key locally.
CREDENTIAL_ENCRYPTION_KEYS={"k1":""}
# Which key id above new writes are encrypted under.
CREDENTIAL_ACTIVE_KEY_ID=k1

# ---------------------------------------------------------------------------
# Postgres — migrations only (scripts/apply-migration.mjs)
# ---------------------------------------------------------------------------
# DIRECT_URL is session mode (port 5432) and is the one migrations use.
# DATABASE_URL is the transaction pooler (port 6543, pgbouncer=true); it
# multiplexes statements and is a poor fit for DDL.
DIRECT_URL=
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Server-only (plan §54). There is deliberately no NEXT_PUBLIC_ variant: the
# vision calls run in route handlers so the key never reaches a browser.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Inngest event delivery and request verification. Server-only.
# Local `next dev` selects the Inngest dev server automatically; Vercel builds
# select Inngest Cloud automatically. Do not set INNGEST_DEV in Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Public on purpose — the upload form checks the size before sending, and the
# server enforces the same limit again. Defaults to 10 MB if unset.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------
# Public DSN. Uses the existing app project when omitted; set per environment.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to production only. Set false to disable; true enables local testing.
NEXT_PUBLIC_SENTRY_ENABLED=
# Public environment label; set staging/preview for non-production deployments.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Performance sampling, 0..1. Default: 0.1 (10%); errors are not sampled by this.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Build-only settings. Put the token in the CI/build secret store, never in a
# NEXT_PUBLIC_ variable or the deployed runtime. All three enable source uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional immutable release identifier; defaults to the detected git commit.
SENTRY_RELEASE=
# Set false for verification builds to prevent uploads and release creation,
# even when build credentials exist. Leave empty in release builds.
SENTRY_UPLOAD_SOURCE_MAPS=
