# Copy to .env.local (or .env) and fill in. Never commit real values — plan §71.
# Both files are gitignored; only this example is tracked.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Supabase renamed its API keys. Either naming scheme works; use whichever your
# project dashboard shows and set only one of each pair.
#
#   classic                        new
#   anon key                  ->   publishable key  (sb_publishable_...)
#   service_role key          ->   secret key       (sb_secret_...)

# Project URL. Prefix with NEXT_PUBLIC_ only if browser code needs it; the app
# as it stands talks to Supabase exclusively from the server.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key. Safe to expose — RLS still applies to it.
SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service-role key. BYPASSES RLS. Server-only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Postgres — migrations only (scripts/apply-migration.mjs)
# ---------------------------------------------------------------------------
# DIRECT_URL is session mode (port 5432) and is the one migrations use.
# DATABASE_URL is the transaction pooler (port 6543, pgbouncer=true); it
# multiplexes statements and is a poor fit for DDL.
DIRECT_URL=
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Server-only (plan §54). There is deliberately no NEXT_PUBLIC_ variant: the
# vision calls run in route handlers so the key never reaches a browser.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash.
GEMINI_MODEL=

# Dedicated worker tuning. Keep concurrency within your Gemini quota and the
# memory available to the worker container, not the Next.js web container.
AI_WORKER_CONCURRENCY=2
AI_WORKER_POLL_MS=1500
AI_WORKER_LEASE_SECONDS=600

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Public on purpose — the upload form checks the size before sending, and the
# server enforces the same limit again. Defaults to 10 MB if unset.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
